{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/2/search\\?(?:(?:j|%6[aA])(?:q|%71)(?:l|%6[cC])=[^&]+)",
    "queryParameters": {
      "jql": {
        "equalTo": "project = EMPTY ORDER BY key ASC"
      }
    },
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mock-jira-token"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "bodyFileName": "search/empty-all.json",
    "transformers": [
      "response-template"
    ]
  }
}
