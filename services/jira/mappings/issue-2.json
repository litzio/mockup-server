{
  "priority": 1,
  "request": {
    "method": "GET",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mock-jira-token"
      }
    },
    "urlPattern": "/rest/api/2/issue/(MOCK-2|10002)"
  },
  "response": {
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "status": 200,
    "bodyFileName": "issues/MOCK-2.json",
    "transformers": [
      "response-template"
    ]
  }
}
