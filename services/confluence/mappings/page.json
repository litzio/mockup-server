{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/content/(20001|20002|20003)",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mock-confluence-token"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "bodyFileName": "pages/{{request.pathSegments.[3]}}.json",
    "transformers": [
      "response-template"
    ]
  }
}
