{
  "priority": 10,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/space/[A-Z][A-Z0-9_]*/content/page\\?(start=[^&]+&limit=[^&]+|limit=[^&]+&start=[^&]+)",
    "queryParameters": {
      "start": {
        "hasExactly": [
          {
            "equalTo": "4"
          }
        ]
      },
      "limit": {
        "hasExactly": [
          {
            "equalTo": "2"
          }
        ]
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "jsonBody": {
      "statusCode": 401,
      "message": "Authentication required",
      "reason": "Unauthorized"
    }
  }
}
