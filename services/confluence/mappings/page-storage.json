{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/content/(20001|20002|20003)\\?expand=[^&]+",
    "queryParameters": {
      "expand": {
        "hasExactly": [
          {
            "equalTo": "body.storage"
          }
        ]
      }
    },
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mock-confluence-token"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "bodyFileName": "pages/{{request.pathSegments.[3]}}-storage.json",
    "transformers": [
      "response-template"
    ]
  }
}
