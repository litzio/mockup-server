{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/space/EMPTY/content/page",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mock-confluence-token"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "jsonBody": {
      "results": [],
      "start": 0,
      "limit": 25,
      "size": 0,
      "_links": {
        "base": "{{request.baseUrl}}",
        "context": "",
        "self": "{{request.baseUrl}}{{{request.url}}}"
      }
    },
    "transformers": [
      "response-template"
    ]
  }
}
