{
  "priority": 10,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/content/[1-9][0-9]*\\?expand=[^&]+",
    "queryParameters": {
      "expand": {
        "hasExactly": [
          {
            "equalTo": "body.storage"
          }
        ]
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "jsonBody": {
      "statusCode": 401,
      "message": "Authentication required",
      "reason": "Unauthorized"
    }
  }
}
