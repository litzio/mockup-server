{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/space/EMPTY/content/page\\?(start=[^&]+&limit=[^&]+|limit=[^&]+&start=[^&]+)",
    "queryParameters": {
      "start": {
        "hasExactly": [
          {
            "equalTo": "4"
          }
        ]
      },
      "limit": {
        "hasExactly": [
          {
            "equalTo": "2"
          }
        ]
      }
    },
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mock-confluence-token"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "jsonBody": {
      "results": [],
      "start": 4,
      "limit": 2,
      "size": 0,
      "_links": {
        "base": "{{request.baseUrl}}",
        "context": "",
        "self": "{{request.baseUrl}}{{{request.url}}}"
      }
    },
    "transformers": [
      "response-template"
    ]
  }
}
