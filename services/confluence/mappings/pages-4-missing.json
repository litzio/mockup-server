{
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPattern": "/rest/api/space/[A-Z][A-Z0-9_]*/content/page\\?(start=[^&]+&limit=[^&]+|limit=[^&]+&start=[^&]+)",
    "queryParameters": {
      "start": {
        "hasExactly": [
          {
            "equalTo": "4"
          }
        ]
      },
      "limit": {
        "hasExactly": [
          {
            "equalTo": "2"
          }
        ]
      }
    },
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mock-confluence-token"
      }
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json",
      "Connection": "close"
    },
    "jsonBody": {
      "statusCode": 404,
      "message": "No content found",
      "reason": "Not Found"
    }
  }
}
